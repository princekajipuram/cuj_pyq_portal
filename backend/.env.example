# Port number for the backend Express API server
PORT=5000

# Environment mode: development or production
NODE_ENV=development

# MongoDB connection string URI (Atlas recommended for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pyq_portal?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_super_secret_jwt_signature_key_change_me_in_production
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configurations (Required for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173
